---
pagination:
  data: cms.renderPages
  size: 1
  alias: p
permalink: "{{ p.permalink }}"
eleventyComputed:
  eleventyExcludeFromCollections: true
---
{%- set s = cms.settings -%}
<!doctype html><html lang="lt"><head><script async src="https://www.googletagmanager.com/gtm.js?id=GTM-5RD2FQZN"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
</script><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ p.meta_title or p.title }}</title><meta name="description" content="{{ p.meta_description }}"><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Work+Sans:wght@400;450;500;550;600&display=swap" rel="stylesheet"><link rel="icon" href="/favicon.ico" sizes="any"><link rel="icon" type="image/png" href="/favicon.png"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><link rel="stylesheet" href="/style.css"><script src="/app.js" defer></script><link rel="canonical" href="{{ cms.base }}{{ p.url }}"><meta property="og:type" content="website"><meta property="og:locale" content="lt_LT"><meta property="og:site_name" content="{{ s.site_name }}"><meta property="og:title" content="{{ p.meta_title or p.title }}"><meta property="og:description" content="{{ p.meta_description }}"><meta property="og:url" content="{{ cms.base }}{{ p.url }}"><meta property="og:image" content="{{ (p.og_image or s.og_image) | abs(cms.base) }}"><meta property="og:image:alt" content="{{ s.og_image_alt }}"><meta name="twitter:card" content="summary_large_image"><script type="application/ld+json">{{ p.schema | dump | safe }}</script><meta name="robots" content="{{ 'noindex, follow' if p.noindex else 'index, follow' }}"></head><body id="top" class="{% if p.blocks and p.blocks[0].type == "hero" and not p.blocks[0].hidden %}header-overlay{% endif %}{% if p.offer and p.offer.isExpired %} offer-expired{% endif %}"{% if p.offer and p.offer.until %} data-offer-until="{{ p.offer.until }}"{% endif %}><a class="skip" href="#turinys">Pereiti į turinį</a>
{%- include "partials/header.njk" -%}
<main id="turinys">
{%- for b in p.blocks -%}
{%- if not b.hidden -%}
{%- set tpl = "blocks/" + b.type + ".njk" -%}
{%- include tpl ignore missing -%}
{%- endif -%}
{%- endfor -%}
</main>
{%- include "partials/footer.njk" -%}
{%- if not p.hasForm %}{% include "partials/registration-popup.njk" %}{% endif -%}
{%- if p.offer and not p.offer.isExpired %}{% include "partials/offer-sticky.njk" %}{% endif -%}
</body></html>
