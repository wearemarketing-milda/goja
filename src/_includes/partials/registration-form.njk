{#- Naudojimas: set fp (ID prefiksas), fb (registracijos bloko turinys) -#}
<form action="/api/registracija" id="{{ fp }}registration-form" class="registration-form" method="post" data-offers="{{ cms.offerKeys | dump }}"><p class="form-offer" hidden></p><input type="hidden" name="offer" value=""><div aria-hidden="true" class="form-trap"><label for="{{ fp }}website">Svetainė</label><input autocomplete="off" id="{{ fp }}website" name="website" tabindex="-1"></div><div class="form-grid"><div class="field"><label for="{{ fp }}fullname">Vardas ir pavardė <span>*</span></label><input autocomplete="name" id="{{ fp }}fullname" maxlength="100" name="fullname" required></div><div class="field"><label for="{{ fp }}phone">Telefonas <span>*</span></label><input autocomplete="tel" id="{{ fp }}phone" maxlength="25" name="phone" pattern="[+0-9() &#45;]{6,25}" placeholder="+370" required type="tel"></div><div class="field full"><label for="{{ fp }}email">El. paštas (nebūtina)</label><input autocomplete="email" id="{{ fp }}email" maxlength="150" name="email" type="email"></div><div class="field full"><label for="{{ fp }}service">Dominanti paslauga</label><select id="{{ fp }}service" name="service"><option value="">Pasirinkite paslaugą</option><option value="nemokama-implantacijos-konsultacija">Nemokama konsultacija dėl implantacijos</option><option value="burnos-higiena">Burnos higiena</option><option value="terapine-odontologija">Terapinė odontologija</option><option value="vaiku-odontologija">Vaikų odontologija</option><option value="estetinis-plombavimas">Estetinis plombavimas</option><option value="dantu-protezavimas">Dantų protezavimas</option><option value="dantu-implantacija">Dantų implantacija</option><option value="konsultacija">Konsultacija / kita paslauga</option></select></div><div class="field full"><label for="{{ fp }}message">Komentaras arba klausimas (nebūtina)</label><textarea id="{{ fp }}message" maxlength="1500" name="message" placeholder="Jei turite klausimų ar norite ką nors papildyti, parašykite čia." rows="4"></textarea></div></div><label class="consent"><input name="consent" required type="checkbox"><span>Sutinku, kad klinika susisiektų nurodytais kontaktais. Susipažinau su <a href="{{ s.privacy_link.url }}">privatumo politika</a>. *</span></label><button class="button" type="submit">{{ fb.submit_text }}</button><p class="form-help">{{ fb.help_text }}</p><p hidden id="{{ fp }}form-error" class="form-error" role="alert"></p><div hidden id="{{ fp }}form-result" class="form-result" role="status" tabindex="-1"><h3>{{ fb.success_title }}</h3><p>{{ fb.success_text }}</p></div><noscript><p>Įjunkite JavaScript arba skambinkite <a href="tel:{{ s.phone_link }}">{{ s.phone }}</a>.</p></noscript></form>
