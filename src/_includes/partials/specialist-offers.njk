{%- if d.offer -%}{%- set o = d.offer -%}
<section class="section specialist-offers" aria-label="Pasiūlymas su {{ d.firstName }}">
<a class="offer-feature" href="{{ o.url }}"><span class="offer-feature-media">{% image o.cardImage, { sizes: "(max-width: 760px) 100vw, 55vw" } %}</span><span class="offer-feature-copy">
{%- if o.validText %}<span class="offer-feature-valid">{{ o.validText }}</span>{% endif -%}
<span class="offer-feature-title">{{ o.title }}{% if o.title_price %} <span class="offer-feature-price">{{ o.title_price }}</span>{% endif %}</span>
{%- if o.payment_note %}<span class="offer-feature-note offer-feature-pay"><span class="offer-free-icon" aria-hidden="true"></span>{{ o.payment_note }}</span>{% endif -%}
{%- if o.card_note %}<span class="offer-feature-note"><span class="offer-free-icon" aria-hidden="true"></span>{{ o.card_note }}</span>{% endif -%}
<span class="button offer-feature-cta">Plačiau apie pasiūlymą <span aria-hidden="true">→</span></span></span></a></section>
{%- endif -%}
