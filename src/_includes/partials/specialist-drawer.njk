{%- set d = m -%}{%- set headingTag = "h2" -%}{%- set headingId = "specialistas-" + m.slug + "-title" -%}
<dialog class="specialist-drawer" id="specialistas-{{ m.slug }}" aria-labelledby="{{ headingId }}"><div class="specialist-drawer-inner"><button class="specialist-drawer-close" type="button" aria-label="Uždaryti">×</button><div class="specialist-drawer-portrait">{% image { src: m.photo, alt: (m.portrait_alt or m.name) }, { dims: false } %}</div><div class="specialist-drawer-copy implant-doctor-copy">{% include "partials/specialist-copy.njk" %}<div class="specialist-actions"><a class="button" href="{{ m.buttonUrl }}">{{ m.buttonText }}</a><a class="text-link" href="{{ m.url }}">Visas specialisto profilis</a></div></div>
{%- set offersId = "drawer-" + m.slug + "-pasiulymai" -%}{% include "partials/specialist-offers.njk" %}
{%- if m.serviceLinks.length -%}{%- set sliderItems = m.serviceLinks -%}{%- set sliderTitle = "Teikiamos paslaugos" -%}{%- set sliderId = "drawer-" + m.slug + "-paslaugos" -%}{%- set sliderEyebrow = "" -%}{%- set sliderLink = null -%}{%- set sliderLinkText = "" -%}{%- set sliderClass = "specialist-services-slider" -%}{% include "partials/service-slider.njk" %}{%- endif -%}
</div></dialog>
