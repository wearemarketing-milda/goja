{#- Naudojimas: set sliderItems, sliderTitle, sliderId, sliderEyebrow, sliderLink, sliderLinkText, sliderClass -#}
<section class="related-services section {{ sliderClass }}" aria-labelledby="{{ sliderId }}"><div class="related-services-head"><div>{% if sliderEyebrow %}<p class="eyebrow">{{ sliderEyebrow }}</p>{% endif %}<h2 id="{{ sliderId }}">{{ sliderTitle }}</h2></div>{% if sliderLink and sliderLink.text %}<a class="button" href="{{ sliderLink.url }}">{{ sliderLink.text }}</a>{% endif %}</div>
<div class="services-slider" data-slider><div class="services-slider-track" data-slider-track>
{%- for c in sliderItems %}<a class="home-service-card" href="{{ c.url }}" draggable="false"><div class="home-service-photo{{ " uncropped" if c.card_uncropped }}">{% image c.card_image %}</div><div class="home-service-copy"><h3>{{ c.card_title or c.nav_label }}</h3>{% if c.card_text %}<p>{{ c.card_text }}</p>{% endif %}<span class="card-link">{{ sliderLinkText or "Plačiau apie paslaugą" }}</span></div></a>{% endfor -%}
</div><div class="services-slider-nav"><button class="slider-arrow" type="button" data-slider-prev aria-label="Ankstesnės paslaugos"><span aria-hidden="true">←</span></button><button class="slider-arrow" type="button" data-slider-next aria-label="Kitos paslaugos"><span aria-hidden="true">→</span></button></div></div></section>
