<section class="section price-catalog"><div class="price-tools"><div><label for="price-search">{{ b.search_label }}</label><input autocomplete="off" id="price-search" placeholder="{{ b.search_placeholder }}" type="search"></div><p>{{ b.info | mdi | safe }}</p></div><p aria-live="polite" id="price-count" role="status"></p><div id="price-groups">{% for g in b.groups %}<details class="price-group"{% if g.open %} open{% endif %}><summary>{{ g.title }}</summary><div>{% for n in g.notes %}<p class="price-note">{{ n | mdi | safe }}</p>{% endfor %}<table><caption class="sr-only">{{ g.title }}</caption><thead><tr><th scope="col">Paslauga</th><th scope="col">Kaina, €</th></tr></thead><tbody>{% for r in g.rows %}<tr class="price-row"><th scope="row">{{ r.service }}</th><td>{{ r.price }}</td></tr>{% endfor %}</tbody></table></div></details>{% endfor %}</div><p hidden id="price-empty">{{ b.empty_text | mdi | safe }}</p>{% if b.notes.length %}<aside class="price-notes"><h3>{{ b.notes_title }}</h3><ul>{% for n in b.notes %}<li>{{ n | mdi | safe }}</li>{% endfor %}</ul></aside>{% endif %}</section>
