<section class="section price-catalog"><div class="price-sticky"><div class="price-tools"><div><label for="price-search">{{ b.search_label }}</label><input autocomplete="off" id="price-search" placeholder="{{ b.search_placeholder }}" type="search"></div><div class="price-toc"><label for="price-toc-select">{{ b.toc_label or "Pasirinkite dominančią paslaugų grupę" }}</label><select id="price-toc-select" class="price-toc-select"><option value="">Visos paslaugų grupės</option>{% for g in b.groups %}<option value="kainos-{{ g.title | slugify }}">{{ g.title }}</option>{% endfor %}</select></div></div>
<div class="price-colhead" aria-hidden="true"><span class="price-col-service">{{ b.col_service or "Paslauga" }}{% if b.info %}<em class="price-col-note">{{ b.info | mdi | safe }}</em>{% endif %}</span><span class="price-col-price">{{ b.col_price or "Kaina" }}</span></div></div>
<div id="price-groups">{% for g in b.groups %}<details class="price-group" id="kainos-{{ g.title | slugify }}"{% if g.open %} open{% endif %}><summary>{{ g.title }}</summary><div>{% for n in g.notes %}<p class="price-note">{{ n | mdi | safe }}</p>{% endfor %}
<table><caption class="sr-only">{{ g.title }}</caption><colgroup><col><col class="col-price"></colgroup><thead class="sr-only"><tr><th scope="col">{{ b.col_service or "Paslauga" }}</th><th scope="col">{{ b.col_price or "Kaina" }}</th></tr></thead><tbody>
{%- for r in g.rows %}<tr class="price-row"><th scope="row"><a class="price-link" href="{{ b.row_link or '/registracija' }}"><span class="price-name">{{ r.service }}</span>{% if r.description %}<span class="price-desc">{{ r.description | nl2br | safe }}</span>{% endif %}</a></th><td class="price-value">{{ r.price }}{% if r.price and not ("€" in r.price) and ((r.price | first) in "0123456789") %} €{% endif %}</td></tr>{% endfor -%}
</tbody></table></div></details>{% endfor %}</div><p hidden id="price-empty">{{ b.empty_text | mdi | safe }}</p>{% if b.notes.length %}<aside class="price-notes"><h3>{{ b.notes_title }}</h3><ul>{% for n in b.notes %}<li>{{ n | mdi | safe }}</li>{% endfor %}</ul></aside>{% endif %}</section>
