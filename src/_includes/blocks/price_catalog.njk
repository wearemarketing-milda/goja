<section class="section price-catalog has-toc"><aside class="price-toc" aria-label="Paslaugų grupės"><div class="price-toc-inner"><label class="price-toc-label" for="price-toc-select">{{ b.toc_label or "Pasirinkite dominančią paslaugų grupę" }}</label><select id="price-toc-select" class="price-toc-select"><option value="">Visos paslaugų grupės</option>{% for g in b.groups %}<option value="kainos-{{ g.title | slugify }}">{{ g.title }}</option>{% endfor %}</select><ul class="price-toc-list">{% for g in b.groups %}<li><a href="#kainos-{{ g.title | slugify }}" data-price-toc>{{ g.title }}</a></li>{% endfor %}</ul></div></aside><div class="price-main"><div class="price-sticky"><div class="price-tools"><div><label for="price-search">{{ b.search_label }}</label><input autocomplete="off" id="price-search" placeholder="{{ b.search_placeholder }}" type="search"></div><p>{{ b.info | mdi | safe }}</p></div>
<div class="price-colhead" aria-hidden="true"><span>{{ b.col_service or "Paslauga" }}</span><span class="price-cat">{{ b.col_category or "Kategorija" }}</span><span class="price-col-price">{{ b.col_price or "Kaina, €" }}</span></div></div>
{% if b.info %}<p class="price-info-mobile">{{ b.info | mdi | safe }}</p>{% endif %}<div id="price-groups">{% for g in b.groups %}<details class="price-group" id="kainos-{{ g.title | slugify }}"{% if g.open %} open{% endif %}><summary>{{ g.title }}</summary><div>{% for n in g.notes %}<p class="price-note">{{ n | mdi | safe }}</p>{% endfor %}
<table><caption class="sr-only">{{ g.title }}</caption><colgroup><col><col class="col-cat"><col class="col-price"></colgroup><thead class="sr-only"><tr><th scope="col">{{ b.col_service or "Paslauga" }}</th><th scope="col">{{ b.col_category or "Kategorija" }}</th><th scope="col">{{ b.col_price or "Kaina, €" }}</th></tr></thead><tbody>
{%- for r in g.rows %}<tr class="price-row"><th scope="row"><a class="price-link" href="{{ b.row_link or '/registracija' }}"><span class="price-name">{{ r.service }}</span>{% if r.description %}<span class="price-desc">{{ r.description | nl2br | safe }}</span>{% endif %}</a></th><td class="price-cat"><span class="price-chip">{{ g.title }}</span></td><td class="price-value">{{ r.price }}</td></tr>{% endfor -%}
</tbody></table></div></details>{% endfor %}</div><p hidden id="price-empty">{{ b.empty_text | mdi | safe }}</p>{% if b.notes.length %}<aside class="price-notes"><h3>{{ b.notes_title }}</h3><ul>{% for n in b.notes %}<li>{{ n | mdi | safe }}</li>{% endfor %}</ul></aside>{% endif %}</div></section>
