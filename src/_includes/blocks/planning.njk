<section class="home-about section"><figure>{% image b.image %}</figure><div>{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2>{{ b.title }}</h2>{% if b.lead %}<p class="large-text">{{ b.lead }}</p>{% endif %}<div class="care-planning">{% for i in b.items %}<details{% if i.open %} open{% endif %}><summary>{{ i.title }}</summary><p>{{ i.text }}</p></details>{% endfor %}</div>{% if b.link.text %}<a class="text-link" href="{{ b.link.url }}">{{ b.link.text }}</a>{% endif %}</div></section>
