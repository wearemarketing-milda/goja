<section class="section process">{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2>{{ b.title }}</h2><div class="steps">{% for st in b.steps %}<article><span>{{ ("0" + loop.index) if loop.index < 10 else loop.index }}</span><h3>{{ st.title }}</h3><p>{{ st.text }}</p></article>{% endfor %}</div></section>
