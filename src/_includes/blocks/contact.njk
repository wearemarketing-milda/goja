<section class="contact section"{% if b.anchor %} id="{{ b.anchor }}"{% endif %}><div class="contact-grid"><div>{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2>{{ b.title }}</h2>{% if b.text %}<p>{{ b.text }}</p>{% endif %}{% if b.button.text %}<a class="button{{ " light" if b.button_light }}" href="{{ b.button.url }}">{{ b.button.text }}</a>{% endif %}{% if b.phone.text %}<a class="phone" href="{{ b.phone.url }}">{{ b.phone.text }}</a>{% endif %}{% if b.email.text %}<a class="email" href="{{ b.email.url }}">{{ b.email.text }}</a>{% endif %}</div><div class="contact-details">{% if b.photo.src %}{% image b.photo, { cls: "contact-welcome-photo" } %}{% endif %}<div>{% if b.address_label %}<span class="eyebrow">{{ b.address_label }}</span>{% endif %}<h3>{{ b.address_lines | nl2br | safe }}</h3>{% if b.map_link.text %}<a class="text-link" href="{{ b.map_link.url }}"{% if b.map_link.url | isExternal %} target="_blank" rel="noopener"{% endif %}>{{ b.map_link.text }}</a>{% endif %}</div><div>{% if b.label_style == "eyebrow" %}<span class="eyebrow">{{ b.hours_label }}</span>{% else %}<h3>{{ b.hours_label }}</h3>{% endif %}<dl>{% for h in b.hours %}<div><dt>{{ h.day }}</dt><dd>{{ h.time }}</dd></div>{% endfor %}</dl></div></div></div></section>
