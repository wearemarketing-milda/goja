{%- if b.variant == "about" -%}<section class="team section"{% if b.anchor %} id="{{ b.anchor }}"{% endif %}><div class="section-heading"><h2>{{ b.title }}</h2>{% if b.text %}<p>{{ b.text }}</p>{% endif %}</div><div class="team-grid">{% for m in b.members %}<article><div class="portrait">{% image { src: m.photo, alt: (m.photo_alt or m.name) }, { dims: false } %}</div><h3>{{ m.name }}</h3><p>{{ m.card_role }}</p></article>{% endfor %}</div></section>{%- else -%}<section aria-labelledby="service-team-title" class="service-team section"><div class="section-heading"><h2 id="service-team-title">{{ b.title }}</h2>{% if b.text %}<p>{{ b.text }}</p>{% endif %}</div><div class="team-grid">{% for m in b.members %}<article><div class="portrait">{% image { src: m.photo, alt: (m.photo_alt or m.name) }, { dims: false } %}</div><h3>{{ m.name }}</h3><p>{{ m.card_role }}</p></article>{% endfor %}</div></section>{%- endif -%}
