{%- if b.variant == "about" -%}<section class="team section"{% if b.anchor %} id="{{ b.anchor }}"{% endif %}><div class="section-heading"><h2>{{ b.title }}</h2>{% if b.text %}<p>{{ b.text }}</p>{% endif %}</div><div class="team-grid">{% for m in b.members %}<article>{% if m.hasPage %}<a class="team-card" href="{{ m.url }}" data-specialist="{{ m.slug }}">{% endif %}<div class="portrait">{% image { src: m.photo, alt: (m.photo_alt or m.name) }, { dims: false } %}</div><h3>{{ m.name }}</h3><p>{{ m.card_role }}</p>{% if m.hasPage %}</a>{% endif %}</article>{% endfor %}</div>{% for m in b.members %}{% if m.hasPage %}{% include "partials/specialist-drawer.njk" %}{% endif %}{% endfor %}</section>{%- else -%}<section aria-labelledby="service-team-title" class="service-team section"><div class="section-heading"><h2 id="service-team-title">{{ b.title }}</h2>{% if b.text %}<p>{{ b.text }}</p>{% endif %}</div><div class="team-grid">{% for m in b.members %}<article>{% if m.hasPage %}<a class="team-card" href="{{ m.url }}" data-specialist="{{ m.slug }}">{% endif %}<div class="portrait">{% image { src: m.photo, alt: (m.photo_alt or m.name) }, { dims: false } %}</div><h3>{{ m.name }}</h3><p>{{ m.card_role }}</p>{% if m.hasPage %}</a>{% endif %}</article>{% endfor %}</div>{% for m in b.members %}{% if m.hasPage %}{% include "partials/specialist-drawer.njk" %}{% endif %}{% endfor %}</section>{%- endif -%}
