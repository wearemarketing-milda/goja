{%- set d = b.person -%}{%- if d -%}<section aria-labelledby="implant-doctor-title" class="implant-doctor section" id="{{ d.slug }}"><div class="implant-doctor-portrait">{% image { src: d.photo, alt: (d.portrait_alt or d.name) }, { dims: false } %}</div><div class="implant-doctor-copy">{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2 id="implant-doctor-title">{{ d.name }}</h2>{% if d.role %}<p class="implant-doctor-role">{{ d.role }}</p>{% endif %}{{ d.bio | md | safe }}{% if d.education.length %}<dl class="implant-doctor-education">{% for e in d.education %}<div><dt>{{ e.year }}</dt><dd>{{ e.text }}</dd></div>{% endfor %}</dl>{% endif %}{% if b.button.text %}<a class="button" href="{{ b.button.url }}">{{ b.button.text }}</a>{% endif %}</div></section>{%- endif -%}
