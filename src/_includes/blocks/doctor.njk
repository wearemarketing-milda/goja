{%- set d = b.person -%}{%- if d -%}<section aria-labelledby="implant-doctor-title" class="implant-doctor section" id="{{ d.slug }}"><div class="implant-doctor-portrait">{% image { src: d.photo, alt: (d.portrait_alt or d.name) }, { dims: false } %}</div><div class="implant-doctor-copy">{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2 id="implant-doctor-title">{{ d.name }}</h2>{% if d.roleText %}<p class="implant-doctor-role">{{ d.roleText }}</p>{% endif %}{% if b.text %}{{ b.text | md | safe }}{% elif b.compact %}{{ (d.bio.split('\n\n')[0] if d.bio else '') | md | safe }}{% else %}{{ d.bio | md | safe }}{% endif %}{% if d.education.length and not b.compact %}<dl class="implant-doctor-education">{% for e in d.education %}<div><dt>{{ e.year }}</dt><dd>{{ e.text }}</dd></div>{% endfor %}</dl>{% endif %}<div class="specialist-actions">{% if b.button.text %}<a class="button" href="{{ b.button.url }}">{{ b.button.text }}</a>{% endif %}{% if d.hasPage %}<a class="text-link" href="{{ d.url }}">Plačiau apie specialistą</a>{% endif %}</div></div></section>{%- endif -%}
