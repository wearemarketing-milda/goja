<section class="section registration"><div>{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2>{{ b.title }}</h2>{% if b.text %}<p>{{ b.text }}</p>{% endif %}{% if b.phone.text %}<a class="phone" href="{{ b.phone.url }}">{{ b.phone.text }}</a>{% endif %}{% if b.email.text %}<a class="email" href="{{ b.email.url }}">{{ b.email.text }}</a>{% endif %}</div><form action="/api/registracija" id="registration-form" method="post" data-offers="{{ cms.offerKeys | dump }}"><p class="form-offer" hidden></p><input type="hidden" name="offer" value=""><div aria-hidden="true" class="form-trap"><label for="website">Svetainė</label><input autocomplete="off" id="website" name="website" tabindex="-1"></div><div class="form-grid"><div class="field"><label for="fullname">Vardas ir pavardė <span>*</span></label><input autocomplete="name" id="fullname" maxlength="100" name="fullname" required></div><div class="field"><label for="phone">Telefonas <span>*</span></label><input autocomplete="tel" id="phone" maxlength="25" name="phone" pattern="[+0-9() &#45;]{6,25}" placeholder="+370" required type="tel"></div><div class="field full"><label for="email">El. paštas (nebūtina)</label><input autocomplete="email" id="email" maxlength="150" name="email" type="email"></div><div class="field full"><label for="service">Dominanti paslauga</label><select id="service" name="service"><option value="">Pasirinkite paslaugą</option><option value="nemokama-implantacijos-konsultacija">Nemokama konsultacija dėl implantacijos</option><option value="burnos-higiena">Burnos higiena</option><option value="terapine-odontologija">Terapinė odontologija</option><option value="vaiku-odontologija">Vaikų odontologija</option><option value="estetinis-plombavimas">Estetinis plombavimas</option><option value="dantu-protezavimas">Dantų protezavimas</option><option value="dantu-implantacija">Dantų implantacija</option><option value="konsultacija">Konsultacija / kita paslauga</option></select></div><div class="field full"><label for="message">Komentaras arba klausimas (nebūtina)</label><textarea id="message" maxlength="1500" name="message" placeholder="Jei turite klausimų ar norite ką nors papildyti, parašykite čia." rows="4"></textarea></div></div><label class="consent"><input name="consent" required type="checkbox"><span>Sutinku, kad klinika susisiektų nurodytais kontaktais. Susipažinau su <a href="{{ s.privacy_link.url }}">privatumo politika</a>. *</span></label><button class="button" type="submit">{{ b.submit_text }}</button><p class="form-help">{{ b.help_text }}</p><p hidden id="form-error" role="alert"></p><div hidden id="form-result" role="status" tabindex="-1"><h3>{{ b.success_title }}</h3><p>{{ b.success_text }}</p></div><noscript><p>Įjunkite JavaScript arba skambinkite <a href="tel:{{ s.phone_link }}">{{ s.phone }}</a>.</p></noscript></form></section>
