{%- set fp = "" -%}{%- set fb = b -%}
{%- if b.layout == "page" -%}
{%- set addr = b.address_text or s.contact_section.address_lines -%}{%- set addrUrl = b.address_url or s.maps_url -%}
<section class="section registration registration-page"><div class="registration-intro">{% include "partials/breadcrumbs.njk" %}<div class="registration-sticky"><h1>{{ b.title or p.title }}</h1>{% if b.text %}<div class="registration-lead">{{ b.text | md | safe }}</div>{% endif %}
<ul class="registration-contacts">{% if b.phone.text %}<li><span class="eyebrow">Telefonas</span><a href="{{ b.phone.url }}">{{ b.phone.text }}</a></li>{% endif %}{% if b.email.text %}<li><span class="eyebrow">El. paštas</span><a href="{{ b.email.url }}">{{ b.email.text }}</a></li>{% endif %}{% if addr %}<li><span class="eyebrow">Adresas</span><a href="{{ addrUrl }}" target="_blank" rel="noopener">{{ addr }}</a></li>{% endif %}</ul></div></div>
<div class="registration-form-col">{% include "partials/registration-form.njk" %}</div></section>
{%- else -%}
<section class="section registration"><div>{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2>{{ b.title }}</h2>{% if b.text %}<p>{{ b.text }}</p>{% endif %}{% if b.phone.text %}<a class="phone" href="{{ b.phone.url }}">{{ b.phone.text }}</a>{% endif %}{% if b.email.text %}<a class="email" href="{{ b.email.url }}">{{ b.email.text }}</a>{% endif %}</div>{% include "partials/registration-form.njk" %}</section>
{%- endif -%}
