<section class="clinic-contact section"{% if b.anchor %} id="{{ b.anchor }}"{% endif %}><div class="clinic-contact-copy"><div class="clinic-contact-head">{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2>{{ b.title }}</h2>{% if b.text %}<p>{{ b.text }}</p>{% endif %}<div class="clinic-contact-actions">{% if b.button.text %}<a class="button" href="{{ b.button.url }}">{{ b.button.text }}</a>{% endif %}{% if b.phone.text %}<a class="phone" href="{{ b.phone.url }}">{{ b.phone.text }}</a>{% endif %}</div></div>
<div class="clinic-contact-details"><div><span class="eyebrow">{{ b.address_label }}</span><h3>{{ b.address_lines | nl2br | safe }}</h3>{% if b.map_link.text %}<a class="text-link" href="{{ b.map_link.url }}"{% if b.map_link.url | isExternal %} target="_blank" rel="noopener"{% endif %}>{{ b.map_link.text }}</a>{% endif %}</div>
<div><span class="eyebrow">{{ b.hours_label }}</span><dl>{% for h in b.hours %}<div><dt>{{ h.day }}</dt><dd>{{ h.time }}</dd></div>{% endfor %}</dl></div>
{% if b.email.text or b.contacts_label %}<div><span class="eyebrow">{{ b.contacts_label }}</span>{% if b.phone.text %}<a class="clinic-contact-line" href="{{ b.phone.url }}">{{ b.phone.text }}</a>{% endif %}{% if b.email.text %}<a class="clinic-contact-line" href="{{ b.email.url }}">{{ b.email.text }}</a>{% endif %}</div>{% endif %}</div></div>
<div class="clinic-contact-media">{% for im in b.images %}<figure>{% image im %}</figure>{% endfor %}</div></section>
