<section aria-labelledby="implant-offer-title" class="implant-offer section"{% if b.anchor %} id="{{ b.anchor }}"{% endif %}><div class="implant-offer-summary">{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2 id="implant-offer-title">{{ b.title }}</h2><p class="implant-offer-price">{{ b.price }} <span>{{ b.currency }}</span></p>{% if b.button.text %}<a class="button" href="{{ b.button.url }}">{{ b.button.text }}</a>{% endif %}</div><div class="implant-offer-inclusions"><h3>{{ b.inclusions_title }}</h3><ul>{% for i in b.inclusions %}<li>{{ i | mdi | safe }}</li>{% endfor %}</ul></div></section>
