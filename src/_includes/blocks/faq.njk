<section class="section faq-section" aria-labelledby="faq-title"><div class="faq">{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2 id="faq-title">{{ b.title }}</h2>
{%- for i in b.items %}<details{% if i.answer.startsWith("[PAVYZDYS") %} class="is-draft"{% endif %}><summary>{{ i.question }}</summary>{{ i.answer | md | safe }}</details>{% endfor -%}
</div></section>
