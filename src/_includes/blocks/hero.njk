<section class="hero"><div class="hero-copy">{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h1>{{ b.title }}</h1>{% if b.intro %}<p class="intro">{{ b.intro }}</p>{% endif %}{% if b.button.text %}<a class="button light" href="{{ b.button.url }}">{{ b.button.text }}</a>{% endif %}{% if b.phone.text %}<a class="hero-phone" href="{{ b.phone.url }}">{{ b.phone.text }}</a>{% endif %}</div><figure class="hero-photo">{% image b.image, { priority: true } %}</figure></section>
