{%- set offer = b.offerItem -%}
<section class="hero-full"><div class="hero-media" aria-hidden="true"><picture>{% if b.image_mobile.src %}<source media="(max-width: 760px)" srcset="{{ b.image_mobile.src }}">{% endif %}{% image b.image, { priority: true, sizes: "100vw" } %}</picture>
{%- if b.video or b.video_mobile %}<video class="hero-video" muted loop playsinline preload="none" data-src="{{ b.video or b.video_mobile }}" data-src-mobile="{{ b.video_mobile or b.video }}"></video>{% endif -%}
</div><div class="hero-inner"><div class="hero-copy">{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h1>{{ b.title }}</h1>{% if b.intro %}<p class="intro">{{ b.intro }}</p>{% endif %}
<div class="hero-actions">{% if b.button.text %}<a class="button light" href="{{ b.button.url }}">{{ b.button.text }}</a>{% endif %}{% if b.phone.text %}<a class="button ghost" href="{{ b.phone.url }}">{{ b.phone.text }}</a>{% endif %}</div></div>
{%- if offer -%}
<a class="hero-offer" href="{{ b.offer_url or '/pasiulymai' }}"><span class="hero-offer-top"><span class="hero-offer-label"><svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 1.5 9.9 5.4l4.3.6-3.1 3 .7 4.3L8 11.3l-3.8 2 .7-4.3-3.1-3 4.3-.6Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>{{ b.offer_label or "Specialus pasiūlymas" }}</span><span class="hero-offer-arrow" aria-hidden="true">↗</span></span>
{%- if offer.price %}<span class="hero-offer-price">{{ offer.price }} {{ offer.currency }}</span>{% endif -%}
<span class="hero-offer-title">{{ offer.title }}</span>{% if offer.card_note %}<span class="hero-offer-note">{{ offer.card_note }}</span>{% endif %}</a>
{%- endif -%}
</div></section>
