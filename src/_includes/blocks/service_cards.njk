{%- set parentPage = cms.bySlug[b.parent or "paslaugos"] -%}{%- set items = parentPage.children if parentPage else [] -%}{%- if b.variant == "index" -%}<section class="section services-index">{% if b.title %}<div class="section-heading"><div>{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2>{{ b.title }}</h2></div>{% if b.text %}<p>{{ b.text }}</p>{% endif %}</div>{% endif %}<div class="service-features">{% for c in items %}<a class="service-card" href="{{ c.url }}"><div class="service-card-photo{{ " uncropped" if c.card_uncropped }}">{% image c.card_image %}</div><div class="service-card-text"><h2>{{ c.card_title or c.nav_label }}</h2><p>{{ c.card_text }}</p><span class="card-link">{{ b.card_link_text }}</span></div></a>{% endfor %}</div>{% if b.link.text %}<a class="text-link" href="{{ b.link.url }}">{{ b.link.text }}</a>{% endif %}</section>{%- else -%}<section class="home-services section"><div class="section-heading"><div>{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2>{{ b.title }}</h2></div>{% if b.text %}<p>{{ b.text }}</p>{% endif %}</div><div class="home-service-catalog">{% for c in items %}<a class="home-service-card" href="{{ c.url }}"><div class="home-service-photo{{ " uncropped" if c.card_uncropped }}">{% image c.card_image %}</div><div class="home-service-copy"><h3>{{ c.card_title or c.nav_label }}</h3><p>{{ c.card_text }}</p><span class="card-link">{{ b.card_link_text }}</span></div></a>{% endfor %}</div>{% if b.link.text %}<a class="text-link" href="{{ b.link.url }}">{{ b.link.text }}</a>{% endif %}</section>{%- endif -%}
