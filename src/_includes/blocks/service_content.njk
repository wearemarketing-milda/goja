<section class="section service-content"><div>{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h2>{{ b.title }}</h2>{% if b.button and b.button.text %}<a class="button service-content-button" href="{{ b.button.url }}">{{ b.button.text }}</a>{% endif %}</div><div class="prose">{{ b.body | md | safe }}{% if b.links_text %}<p class="context-links">{{ b.links_text | mdi | safe }}</p>{% endif %}</div></section>
