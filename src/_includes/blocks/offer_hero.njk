<section class="offer-page-hero section">{% include "partials/breadcrumbs.njk" %}{% if b.eyebrow %}<p class="eyebrow">{{ b.eyebrow }}</p>{% endif %}<h1>{{ b.title }}{% if b.title_price %} <span class="offer-title-price">{{ b.title_price }}</span>{% endif %}</h1>{% if b.lead %}<p class="page-lead">{{ b.lead }}</p>{% endif %}{% if b.box_title or b.box_text %}<div class="free-consultation"><h2>{{ b.box_title }}</h2><p>{{ b.box_text }}</p></div>{% endif %}{% if b.button.text %}<a class="button" href="{{ b.button.url }}">{{ b.button.text }}</a>{% endif %}</section>
