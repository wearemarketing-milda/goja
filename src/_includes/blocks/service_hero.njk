<section class="service-hero section">{% include "partials/breadcrumbs.njk" %}<div class="service-hero-grid"><div>{% if b.eyebrow %}<p class="eyebrow"><i></i> {{ b.eyebrow }}</p>{% endif %}<h1>{{ b.title }}</h1>{% if b.lead %}<p class="page-lead">{{ b.lead }}</p>{% endif %}{% if b.intro %}<p class="implant-doctor-intro">{{ b.intro | mdi | safe }}</p>{% endif %}{% if b.button.text %}<a class="button" href="{{ b.button.url }}">{{ b.button.text }}</a>{% endif %}{% if b.offer_link.text %}<a class="implant-offer-link" href="{{ b.offer_link.url }}">{{ b.offer_link.text }} <span aria-hidden="true">↓</span></a>{% endif %}</div>{% image b.image, { cls: ("service-main-photo uncropped" if b.image_uncropped else "service-main-photo"), priority: true } %}</div></section>
